# Copy to .env for personal reference; do not commit real keys.
# Run `export $(grep -v '^#' .env | xargs)` only if all values are shell-safe.
PDSIA_DB=pdsia.db
PDSIA_API_TOKEN=replace-with-a-long-random-secret
PDSIA_ALLOW_DEMO_WRITES=1
PDSIA_REVIEWER_ID=team-reviewer
PDSIA_ARCHIVE_DIR=data/live
